# =====================================================
#  EXPLORADOR DE CATALUNYA — Plantilla de variables d'entorn
# =====================================================
#  Copia aquest fitxer a .env i ajusta els valors:
#
#     cp .env.example .env
#
#  El fitxer .env NO es puja a GitHub (està al .gitignore).
# =====================================================

# ---------- Base de dades (PostgreSQL) ----------
POSTGRES_USER=catalunya_user
POSTGRES_PASSWORD=canvia_aixo_per_un_password_segur
POSTGRES_DB=catalunya_db
POSTGRES_PORT=5432

# ---------- Backend (Node.js + Express) ----------
BACKEND_PORT=5000
BACKEND_HOST_PORT=5001

# ---------- Frontend (Next.js) ----------
FRONTEND_PORT=80
FRONTEND_HOST_PORT=8080

# ---------- Proxy invers (Nginx) ----------
PROXY_PORT=8000

# ---------- Administració (Basic Auth) ----------
# Credencials per accedir a /admin
ADMIN_USER=admin
ADMIN_PASSWORD=canvia_aixo_per_un_password_segur
